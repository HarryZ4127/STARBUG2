+  if (const char* tp = getenv("STARBUG_TRACE")) {
+    g_starbug_trace = fopen(tp, "w");
+    if (g_starbug_trace) setvbuf(g_starbug_trace, nullptr, _IOFBF, 1 << 22);
+  }
+  memory_interface = new StarbugTraceMemory(memory_interface, &starbug_db_factory);
   // Set up architectural state and decoder.
   RiscVState rv_state("RiscV32", RiscVXlen::RV32, memory_interface,
                       atomic_memory);
